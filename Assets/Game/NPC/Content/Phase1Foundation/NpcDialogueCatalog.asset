  - dialogueId: dialogue.berryman.work
    characterDefinitionId: character.berryman
    lines:
    - lineId: line.berryman.babble.01
      localizationKey: npc.berryman.babble.01
      fallbackSubtitle: Damn it will be dark before this field is done!
      audioEventId: audio.npc.berryman.babble.01
      cooldownGameSeconds: 0
      conditions: []
      emittedEventId: event.npc.berryman.job-interaction
    - lineId: line.berryman.babble.02
      localizationKey: npc.berryman.babble.02
      fallbackSubtitle: Damn those strawberries will go rotten before you finish
        that job!
      audioEventId: audio.npc.berryman.babble.02
      cooldownGameSeconds: 0
      conditions: []
      emittedEventId: event.npc.berryman.job-interaction
    - lineId: line.berryman.babble.03
      localizationKey: npc.berryman.babble.03
      fallbackSubtitle: Damn, my mother who had fatality would have picked four boxes
        in same time you pick one!
      audioEventId: audio.npc.berryman.babble.03
      cooldownGameSeconds: 0
      conditions: []
      emittedEventId: event.npc.berryman.job-interaction
    - lineId: line.berryman.babble.04
      localizationKey: npc.berryman.babble.04
      fallbackSubtitle: I haven't slept for three weeks because of night frost warning!
        Damn strawberries going bad!
      audioEventId: audio.npc.berryman.babble.04
      cooldownGameSeconds: 0
      conditions: []
      emittedEventId: event.npc.berryman.job-interaction
